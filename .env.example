# The shared API token: the server (and docker compose) and every client. openssl rand -hex 32
SIFTWISE_API_TOKEN=change-me
# A server run outside Docker (uv run uvicorn / siftwise server start), and the tests.
SIFTWISE_DATABASE_URL=postgresql+psycopg://siftwise:siftwise@localhost:5432/siftwise
SIFTWISE_TEST_DATABASE_URL=postgresql+psycopg://siftwise:siftwise@localhost:5432/siftwise_test
# docker compose (defaults): SIFTWISE_PORT=8000, POSTGRES_PASSWORD=siftwise,
# SIFTWISE_PG_VOLUME=siftwise_pgdata
